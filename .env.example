# Copy this file to .env and fill in real values. Never commit .env.

# Flask session secret - generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Stable Diffusion (AUTOMATIC1111 webui) API used for AI prompt generation.
# Leave the default if you don't have one running - save_ia_image() will
# just log "server unavailable" and skip generation (demo/offline mode).
SD_API_HOST=127.0.0.1
SD_API_PORT=7860

# Comma-separated fallback URLs for the optional GPU processing cluster
# used by the timelapse/AI batch scripts. Leave empty if unused.
GPU_CLUSTER_URLS=

# SSH password used by base/monitor.py to poll remote booths (optional tool).
SSH_BOOTH_PASSWORD=changeme

# Used by flask/creation_useradmin.py to seed one admin account.
DEMO_ADMIN_LOGIN=demo_admin
DEMO_ADMIN_PASSWORD=changeme

# Optional overrides for the standalone monitoring scripts (base/monitor.py,
# base/boothsStatus.py, base/checkPod.py, base/photo_scroll.py). All default to
# paths relative to base/ if left unset.
# MONITOR_DB_FILE=./photomatons_status.db
# MONITOR_CONFIG_FILE=./monitor.json
# SLIDESHOW_IMAGE_DIR=./BkpImg
# VMGPU_RESTART_SCRIPT=./vmgpu.sh
# RUNPOD_START_SCRIPT=./runpod/start.sh
